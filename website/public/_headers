# Default headers for all paths
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'

/.well-known/matrix/*
  Content-Type: application/json
  Access-Control-Allow-Origin: *

# The desktop update channel. The site default is max-age=14400, and four hours of apps being
# told there is nothing new is four hours a security fix does not reach anyone who opened the app.
/desktop/*
  Content-Type: application/json
  Cache-Control: public, max-age=300, must-revalidate
